# ═══════════════════════════════════════════════════════════════
# Crime Intelligence Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and customize
# cp .env.example .env
#
# For development: cp .env.development .env
# For production:  cp .env.production .env
# ═══════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────
APP_NAME=Crime Intelligence Platform
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=production

# ── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ── Database (PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://crimeapp:crimeapp123@localhost:5432/crime_intelligence
DATABASE_URL_SYNC=postgresql+psycopg2://crimeapp:crimeapp123@localhost:5432/crime_intelligence
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Authentication ────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Gemini AI ─────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT=60/minute
LOGIN_RATE_LIMIT=10/minute

# ── Redis (Caching) ────────────────────────────────────────────
REDIS_URL=
CACHE_TTL_SECONDS=300

# ── Security ───────────────────────────────────────────────────
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true


CATALYST_FILESTORE_FOLDER_ID=45430000000013072